<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Data Analysis Report — {{ report.dataset.filename }}</title>
<style>
  @page { size: A4; margin: 2cm 1.8cm; }
  * { box-sizing: border-box; }
  body {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    color: #1e293b;
    font-size: 11px;
    line-height: 1.55;
    margin: 0;
  }
  h1, h2, h3 { color: #0f172a; margin: 0 0 0.4em; }
  h1 { font-size: 22px; }
  h2 {
    font-size: 15px;
    margin-top: 1.6em;
    padding-bottom: 0.3em;
    border-bottom: 2px solid #2563eb;
  }
  h3 { font-size: 12px; margin-top: 1em; }
  p { margin: 0 0 0.8em; }
  .cover {
    text-align: center;
    padding: 3em 0 2em;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 1.5em;
  }
  .cover .subtitle { color: #64748b; font-size: 13px; margin-top: 0.3em; }
  .cover .meta { color: #94a3b8; font-size: 10px; margin-top: 1.5em; }
  .badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .badge.good { background: #dcfce7; color: #166534; }
  .badge.warn { background: #fef3c7; color: #92400e; }
  .badge.bad { background: #fee2e2; color: #991b1b; }
  .kpi-row { display: flex; gap: 12px; margin: 1em 0; }
  .kpi {
    flex: 1;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: center;
  }
  .kpi .value { font-size: 18px; font-weight: 700; color: #0f172a; }
  .kpi .label { font-size: 9px; color: #64748b; text-transform: uppercase; letter-spacing: 0.03em; }
  table { width: 100%; border-collapse: collapse; margin: 0.6em 0 1.2em; font-size: 10px; }
  th, td { border: 1px solid #e2e8f0; padding: 5px 8px; text-align: left; }
  th { background: #f1f5f9; font-weight: 600; color: #334155; }
  tr:nth-child(even) { background: #f8fafc; }
  .quality-bar-track { background: #e2e8f0; border-radius: 4px; height: 6px; width: 100%; }
  .quality-bar-fill { background: #2563eb; border-radius: 4px; height: 6px; }
  .issue { margin: 0.3em 0; padding-left: 1em; border-left: 3px solid #cbd5e1; }
  .issue.high { border-color: #ef4444; }
  .issue.medium { border-color: #f59e0b; }
  .issue.low, .issue.info { border-color: #94a3b8; }
  .chart-block { margin: 1em 0; page-break-inside: avoid; text-align: center; }
  .chart-block img { max-width: 100%; border: 1px solid #e2e8f0; border-radius: 6px; }
  .chart-block .caption { font-size: 9px; color: #64748b; margin-top: 0.3em; }
  .ai-insight {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    padding: 12px 14px;
    white-space: pre-wrap;
    font-size: 10.5px;
  }
  .recommendations li { margin: 0.35em 0; }
  .muted { color: #94a3b8; font-style: italic; }
  .footer { margin-top: 2.5em; padding-top: 0.8em; border-top: 1px solid #e2e8f0; font-size: 9px; color: #94a3b8; }
  section { page-break-inside: avoid; }
</style>
</head>
<body>

<div class="cover">
  <h1>AI Data Analyst — Analysis Report</h1>
  <div class="subtitle">{{ report.dataset.filename }}</div>
  <div class="meta">Generated {{ report.generated_at }}</div>
</div>

<section>
  <h2>Executive Summary</h2>
  <p>{{ report.executive_summary }}</p>
  <div class="kpi-row">
    <div class="kpi"><div class="value">{{ "{:,}".format(report.profile.row_count) }}</div><div class="label">Rows</div></div>
    <div class="kpi"><div class="value">{{ report.profile.column_count }}</div><div class="label">Columns</div></div>
    <div class="kpi"><div class="value">{{ report.profile.quality.overall }}/100</div><div class="label">Quality Score</div></div>
    <div class="kpi"><div class="value">{{ report.profile.issues|length }}</div><div class="label">Issues Found</div></div>
  </div>
</section>

<section>
  <h2>Dataset Overview</h2>
  <table>
    <tr><th>Filename</th><td>{{ report.dataset.filename }}</td></tr>
    <tr><th>Rows</th><td>{{ "{:,}".format(report.dataset.row_count) }}</td></tr>
    <tr><th>Columns</th><td>{{ report.dataset.column_count }}</td></tr>
    <tr><th>File size</th><td>{{ "{:,}".format(report.dataset.size_bytes) }} bytes</td></tr>
    <tr><th>Uploaded</th><td>{{ report.dataset.uploaded_at }}</td></tr>
  </table>
</section>

<section>
  <h2>Data Quality</h2>
  {% for key, label in [("completeness","Completeness"), ("missing_values","Missing Values"), ("duplicates","Duplicates"), ("data_types","Data Types"), ("outliers","Outliers")] %}
  <div style="margin-bottom:0.5em;">
    <div style="display:flex; justify-content:space-between; font-size:10px;">
      <span>{{ label }}</span><span>{{ "%.1f"|format(report.profile.quality[key]) }}/10</span>
    </div>
    <div class="quality-bar-track"><div class="quality-bar-fill" style="width: {{ (report.profile.quality[key] / 10 * 100)|round(0, 'floor')|int }}%;"></div></div>
  </div>
  {% endfor %}

  <h3>Detected Issues ({{ report.profile.issues|length }})</h3>
  {% if report.profile.issues %}
    {% for issue in report.profile.issues %}
    <div class="issue {{ issue.severity }}">{{ issue.message }}</div>
    {% endfor %}
  {% else %}
    <p class="muted">No issues detected.</p>
  {% endif %}
</section>

<section>
  <h2>Key Statistics</h2>
  {% if report.numeric_stats %}
  <h3>Numeric Columns</h3>
  <table>
    <tr><th>Column</th><th>Mean</th><th>Median</th><th>Std</th><th>Min</th><th>Max</th><th>Outliers</th></tr>
    {% for c in report.numeric_stats %}
    <tr>
      <td>{{ c.name }}</td>
      <td>{{ "%.2f"|format(c.numeric.mean) if c.numeric.mean is not none else "—" }}</td>
      <td>{{ "%.2f"|format(c.numeric.median) if c.numeric.median is not none else "—" }}</td>
      <td>{{ "%.2f"|format(c.numeric.std) if c.numeric.std is not none else "—" }}</td>
      <td>{{ "%.2f"|format(c.numeric.min) if c.numeric.min is not none else "—" }}</td>
      <td>{{ "%.2f"|format(c.numeric.max) if c.numeric.max is not none else "—" }}</td>
      <td>{{ c.numeric.outlier_count }} ({{ c.numeric.outlier_percentage }}%)</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if report.categorical_stats %}
  <h3>Categorical Columns</h3>
  <table>
    <tr><th>Column</th><th>Distinct Values</th><th>Top Category</th></tr>
    {% for c in report.categorical_stats %}
    <tr>
      <td>{{ c.name }}</td>
      <td>{{ c.categorical.distinct_count }}</td>
      <td>
        {% if c.categorical.top_categories %}
          {{ c.categorical.top_categories[0].value }} ({{ c.categorical.top_categories[0].percentage }}%)
        {% else %}—{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

{% if report.charts %}
<section>
  <h2>Visualizations</h2>
  {% for chart in report.charts %}
  <div class="chart-block">
    <img src="data:image/png;base64,{{ chart.image_base64 }}" alt="{{ chart.title }}">
    <div class="caption">{{ chart.title }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

<section>
  <h2>Anomalies</h2>
  {% if report.anomalies.columns %}
    {% for col in report.anomalies.columns %}
    <h3>{{ col.column }} — {{ col.outlier_count }} outlier(s) ({{ col.outlier_percentage }}%)</h3>
    {% if col.sample_rows %}
    <table>
      <tr>{% for k in col.sample_rows[0].keys() %}<th>{{ k }}</th>{% endfor %}</tr>
      {% for row in col.sample_rows %}
      <tr>{% for v in row.values() %}<td>{{ v }}</td>{% endfor %}</tr>
      {% endfor %}
    </table>
    {% endif %}
    {% endfor %}
  {% else %}
    <p class="muted">No numeric columns with significant outliers were found.</p>
  {% endif %}
</section>

<section>
  <h2>AI Insight</h2>
  {% if report.ai_insight %}
    <div class="ai-insight">{{ report.ai_insight.content }}</div>
    <p class="muted" style="margin-top:0.4em;">From the AI Analyst conversation on {{ report.ai_insight.generated_at }}.</p>
  {% else %}
    <p class="muted">No AI Analyst conversation has been run for this dataset yet — ask a question in AI Analyst first to include grounded insights here.</p>
  {% endif %}
</section>

<section>
  <h2>Recommendations</h2>
  {% if report.recommendations %}
  <ul class="recommendations">
    {% for rec in report.recommendations %}<li>{{ rec }}</li>{% endfor %}
  </ul>
  {% else %}
    <p class="muted">No specific recommendations — dataset appears clean.</p>
  {% endif %}
</section>

<section>
  <h2>Methodology</h2>
  <p>{{ report.methodology }}</p>
</section>

<section>
  <h2>Limitations</h2>
  <p>{{ report.limitations }}</p>
</section>

<div class="footer">
  Generated by AI Data Analyst Agent · {{ report.generated_at }} · Dataset ID: {{ report.dataset.id }}
</div>

</body>
</html>
