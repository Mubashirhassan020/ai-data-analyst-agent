# -----------------------------------------------------------------------------
# AI Data Analyst Agent — environment template
# Copy to `.env` and fill in. NEVER commit a real .env.
# -----------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Used by docker-compose Postgres service and Alembic
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst
POSTGRES_DB=analyst
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://analyst:analyst@postgres:5432/analyst

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_ROOT=/app/data

# --- Uploads ---
# Bytes. Default 200 MB. Enforced server-side.
MAX_UPLOAD_SIZE=209715200
ALLOWED_EXTENSIONS=csv,xlsx,xls

# --- LLM ---
# Provider: openai_compatible (works for OpenAI, Azure OpenAI-compat gateways,
# LiteLLM proxies, local vLLM/Ollama with /v1 endpoints).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
# Leave blank; the app refuses to call the LLM until this is set.
LLM_API_KEY=
# Set to the EXACT model id available on your account. Do not assume aliases stay valid.
# Verify at your provider's model list before setting.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ITERATIONS=6

# --- Frontend (build time) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
